<Window x:Class="CyberSecurityChatBotP2.TopicSelectionWindow"  
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CyberSecurityChatBotP2"
        mc:Ignorable="d"
        Title="Choose a Topic"  
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#121212">

    <!-- Choose a Topic Screen -->
    <Grid>

        <Border Background="#36454F"
                BorderBrush="#688DA5"
                BorderThickness="2"
                CornerRadius="15"
                Height="500"
                Width="600"
                Margin="20,20,20,20">


            <Grid Margin="20">
                    
               <!--Header and content-->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ASCII Art Header -->
                <TextBlock x:Name="AsciiArtHeader"
                           Grid.Row="0"
                           FontFamily="Consolas"
                           FontSize="8"
                           Foreground="#87CEEB"
                           TextWrapping="NoWrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,20"/>

                <!-- Main Content -->
                <Grid Grid.Row="1">
                    
                    
                    <!--On the left will be a swg-->
                    <!--On the right will be welcome username-->
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                <!--Image -->
                    <Border >
                    <Grid>
                        <Image Source="/Images/Maximus.png" 
                               Width="150"
                               Height ="150"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        </Grid>
                        
                     </Border>
                    
                    <!--Welcome name and content-->
                    <StackPanel Grid.Column="1"
                                Margin="20">


                        <TextBlock x:Name="WelcomeUserName"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#688DA5"
                                   Margin="0,10"/>

                     <!-- Inro message-->
                        <TextBlock Text="You are now connected"
                                      FontSize="16"
                                      Foreground="White"
                                      Margin="0,5,0,0"/>

                        
                        <!-- Instructions To user -->
                        <TextBlock Text="Select a topic you would like to learn about"
                                   FontSize="16"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,25"/>


                        <!---The Topics-->
                        
                        <!-- BUTTONS-->
                        
                        <UniformGrid Rows="2"
                                     Columns="3">
                           
                            
                            
                            <!-- PHISHING BUTTON -->
                            <Button Background="#36454F" BorderBrush="#688DA5" Height="85" Margin="4" Click="PhishingButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">  <!--To make boxes cornerRadius-->
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Trigger to change BorderBrush to SkyBlue on Hover -->
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#87CEEB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                
                                <!--The buttons content.-->
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Images/Maximus Icons/Phishing.png" Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                    <TextBlock Text="Phishing" FontSize="13" FontWeight="Bold" Foreground="#688DA5" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    </StackPanel>
                            </Button>
                            
                            

                            <!-- PASSWORD BUTTON-->
                            <Button Background="#36454F" BorderBrush="#688DA5" Height="85" Margin="4" Click="PasswordButton_Click">
                                
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <!--To make boxes cornerRadius-->
                                        <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Trigger to change BorderBrush to SkyBlue on Hover -->
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#87CEEB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>

                                <!--The buttons content.-->
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Images/Maximus Icons/Password.png" Width="18" Height="18" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                    <TextBlock Text="Passwords" FontSize="13" FontWeight="Bold" Foreground="#688DA5" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                                


                            <!-- LINKS BUTTON  -->
                            <Button Background="#36454F" BorderBrush="#688DA5" Height="85" Margin="4" Click="LinksButton_Click">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <!--To make boxes cornerRadius-->
                                        <Border x:Name="border"
                                         Background="{TemplateBinding Background}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Trigger to change BorderBrush to SkyBlue on Hover -->
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#87CEEB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>

                                <!--The buttons content.-->
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Images/Maximus Icons/Links.png" Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                    <TextBlock Text="Links" FontSize="13" FontWeight="Bold" Foreground="#688DA5" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>



                            <!--MALWARE BUTTON-->

                            <Button Background="#36454F" BorderBrush="#688DA5" Height="85" Margin="4" Click="Malware_Click">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <!--To make boxes cornerRadius-->
                                        <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Trigger to change BorderBrush to SkyBlue on Hover -->
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#87CEEB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>

                                <!--The buttons content.-->
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Images/Maximus Icons/Malware.png" Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                    <TextBlock Text="Malware" FontSize="13" FontWeight="Bold" Foreground="#688DA5" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>


                            
                            <!--FIREWALL BUTTON-->

                            <Button Background="#36454F" BorderBrush="#688DA5" Height="85" Margin="4" Click="Firewall_Click">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <!--To make boxes cornerRadius-->
                                        <Border x:Name="border"
             Background="{TemplateBinding Background}"
             BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}"
             CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Trigger to change BorderBrush to SkyBlue on Hover -->
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#87CEEB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>

                                <!--The buttons content.-->
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Images/Maximus Icons/Firewall.png" Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                    <TextBlock Text="Firewall" FontSize="13" FontWeight="Bold" Foreground="#688DA5" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>


                            <!--VPN BUTTON-->

                                <Button Background="#36454F" BorderBrush="#688DA5" Height="85" Margin="4" Click="VPN_Click">
     
                                     <Button.Template>
                                          <ControlTemplate TargetType="Button">
                                           <!--To make boxes cornerRadius-->
                                               <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                           </Border>

             <!-- Trigger to change BorderBrush to SkyBlue on Hover -->
             <ControlTemplate.Triggers>
                 <Trigger Property="IsMouseOver" Value="True">
                     <Setter TargetName="border" Property="BorderBrush" Value="#87CEEB"/>
                 </Trigger>
             </ControlTemplate.Triggers>
         </ControlTemplate>
     </Button.Template>

     <!--The buttons content.-->
     <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
         <Image Source="/Images/Maximus Icons/VPN.png" Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,3"/>
         <TextBlock Text="VPN" FontSize="13" FontWeight="Bold" Foreground="#688DA5" HorizontalAlignment="Center" TextAlignment="Center"/>
     </StackPanel>
 </Button>
                                


                        </UniformGrid>


                    </StackPanel>
                    
                   
            </Grid>
                    </Grid>
</Border>

        
    


        
    </Grid>
    
</Window>
