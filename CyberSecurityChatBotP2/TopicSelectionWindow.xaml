<Window x:Class="CyberSecurityChatBotP2.TopicSelectionWindow"  
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CyberSecurityChatBotP2"
        mc:Ignorable="d"
        Title="Choose a Topic"  
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#121212">

    <!-- Choose a Topic Screen -->
    <Grid>

        <Border Background="#36454F"
 BorderBrush="#688DA5"
 BorderThickness="2"
 CornerRadius="15"
 Height="500"
 Width="600"
 Margin="20,20,20,20">


            <Grid Margin="20">
                    
<!--Header and content-->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ASCII Art Header -->
                <TextBlock x:Name="AsciiArtHeader"
                           Grid.Row="0"
                           FontFamily="Consolas"
                           FontSize="8"
                           Foreground="#87CEEB"
                           TextWrapping="NoWrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,20"/>

                <!-- Main Content -->
                <Grid Grid.Row="1">

             
                    <!--On the left will be a swg-->
                    <!--On the right will be welcome username-->
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                <!--Image -->
                    <Border Grid.Column="0"
                            Background="#36454F"
                            CornerRadius="10"
                            Margin="10">
                    <Grid>
                        <Image Source="Images/Maximus.png" 
                               Width="150"
                               Height ="150"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        </Grid>
                        
                </Border>
                    
                    <!--Welcome name and content-->
                    <StackPanel Grid.Column="1"
                                Margin="20">


                        <TextBlock x:Name="WelcomeUserName"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,10"/>

                     <!-- Inro message-->
                        <TextBlock Text="You are now connected"
                                      FontSize="16"
                                      Foreground="White"
                                      Margin="0,5,0,0"/>

                        
<!-- Instructions -->
                        <TextBlock Text="Select a topic you would like to learn about"
                                   FontSize="16"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,25"/>

                        <!---The Topics-->
                        
                        <!-- Buttons-->
                        
                        <UniformGrid Rows="2"
                                     Columns="3">
                            <!-- Phishing-->

                            <Button Content="Phishing"
                                    Background="#36454F"
                                    Foreground="White"
                                BorderBrush="#688DA5"
                                Height="90"
                                Margin="10"
                                FontSize="16"
                                FontWeight="Bold"
                                Click="PhishingButton_Click"/>

                            <Button Content="Password"
                                     Background="#36454F"
                                    Foreground="White"
                                    BorderBrush="#688DA5"
         Height="90"
         Margin="10"
         FontSize="16"
         FontWeight="Bold"
         Click="PasswordButton_Click"/>


                            <Button Content="Links"
                                     Background="#36454F"
                                    BorderBrush="#688DA5"
 Foreground="White"
         Height="90"
         Margin="10"
         FontSize="16"
         FontWeight="Bold"
         Click="LinksButton_Click"/>


                            <Button Content="Malware"
                                     Background="#36454F"
 Foreground="White"
                                    BorderBrush="#688DA5"
         Height="90"
         Margin="10"
         FontSize="16"
         FontWeight="Bold"
         Click="Malware_Click"/>


                            <Button Content="Firewall"
                                     Background="#36454F"
                                    BorderBrush="#688DA5"
 Foreground="White"
         Height="90"
         Margin="10"
         FontSize="16"
         FontWeight="Bold"
         Click="Firewall_Click"/>


                            <Button Content="VPN"
                                     Background="#36454F"
                                    BorderBrush="#688DA5"
 Foreground="White"
Height="90"
Margin="10"
FontSize="16"
FontWeight="Bold"
Click="VPN_Click"/>


                        </UniformGrid>


                    </StackPanel>
                    
                   
            </Grid>
                    </Grid>
</Border>

        
    


        
    </Grid>
    
</Window>
