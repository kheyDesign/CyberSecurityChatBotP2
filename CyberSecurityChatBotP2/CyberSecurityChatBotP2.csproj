<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Images\NewFolder\**" />
    <EmbeddedResource Remove="Images\NewFolder\**" />
    <None Remove="Images\NewFolder\**" />
    <Page Remove="Images\NewFolder\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Images\Maximus Icons\Firewall.png" />
    <None Remove="Images\Maximus Icons\Links.png" />
    <None Remove="Images\Maximus Icons\Malware.png" />
    <None Remove="Images\Maximus Icons\Password.png" />
    <None Remove="Images\Maximus Icons\Phishing.png" />
    <None Remove="Images\Maximus Icons\VPN.png" />
    <None Remove="Images\Maximus.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="System.Speech" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\Maximus Icons\Firewall.png" />
    <Resource Include="Images\Maximus Icons\Links.png" />
    <Resource Include="Images\Maximus Icons\Malware.png" />
    <Resource Include="Images\Maximus Icons\Password.png" />
    <Resource Include="Images\Maximus Icons\Phishing.png" />
    <Resource Include="Images\Maximus Icons\VPN.png" />
    <Resource Include="Images\Maximus.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="maximus_greeting.wav">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
