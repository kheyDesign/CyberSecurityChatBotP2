<Window x:Class="CyberSecurityChatBotP2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CyberSecurityChatBotP2"
        mc:Ignorable="d"
        Title="Welcome Screen"  
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#121212">

    <!-- Please enter screen.(Welcome Screen)-->
    <Grid x:Name="WelcomeScreen" >

        <Border Background="#36454F"
        BorderBrush="#688DA5"
        BorderThickness="2"
        CornerRadius="15"
        Height="500"
        Width="450"
        Margin="20,59,20,20">

            <!-- Welcome screen Controls -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center" >

            <!--Bot name --> 
            <TextBlock Text="MAXIMUS"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"/>

            <!--descriptive text-->
            <TextBlock Text="Cyber Security Awareness Assistant"
                       FontSize="16"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,15"/>

            <!-- ASCII ART -->
            <TextBlock x:Name="AsciiArtTextBlock"
                       FontFamily="Consolas"
                       FontSize="8"
                       Foreground="#87CEEB"
                       TextWrapping="NoWrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Maximus's Introduction -->
             <!-- Greeting -->
                    <TextBlock Text="Hi There!"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                    <TextBlock Text="I am Maximus. Your Cyber Security Assistant."
                               Foreground="White"
                               FontSize="15"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,5,0,0"/>

                    <!-- Ask user for name. supports memory and bot remembering-->
                    <TextBlock Text="What is your name:"
                               Foreground="White"
                               FontSize="16"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,50,0,15"/>

                    <!-- Lets user enter name -->
                    <TextBox x:Name="NameTextBox"
                             
                             Height="30"
                             Width="300"
                             FontSize="16"
                             Background="Transparent"
                             BorderBrush="#688DA5"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,15"/>

                    <!-- Lets user submit name -->
                <Button Content="Submit"
                            Width="100"
                            Height="30"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="White"
                            Click="SubmitButton_Click">
                    
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#7393B3"
                                    CornerRadius="5">

                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                        </Button.Template>
                </Button>
                           

                </StackPanel>

            </Border>

      
    </Grid>

</Window>